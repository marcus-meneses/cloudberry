{
  "version": 1,
  "resources": [
    {
      "name": "/@io",
      "scope": "display",
      "operations": [
        "display_info",
        "display_fill",
        "display_blit",
        "display_copy",
        "console_access",
        "gpu",
        "owner_watch"
      ]
    },
    {
      "name": "/@display",
      "publish": true,
      "operations": [
        "info",
        "fill",
        "blit",
        "copy"
      ]
    },
    {
      "name": "/@display.render",
      "scope": "display",
      "publish": true,
      "operations": [
        "info",
        "batch",
        "create",
        "release",
        "write",
        "compose",
        "patch"
      ]
    },
    {
      "name": "/@memory",
      "scope": "self",
      "operations": [
        "allocate",
        "free"
      ]
    }
  ]
}
