{
  "version": 1,
  "resources": [
    {
      "name": "/@memory",
      "scope": "self",
      "operations": [
        "allocate",
        "free"
      ]
    },
    {
      "name": "/@io",
      "scope": "hid",
      "operations": [
        "hid_subscribe",
        "hid_list",
        "hid_open",
        "hid_descriptor",
        "hid_start",
        "hid_ack",
        "hid_close",
        "now_ns",
        "owner_watch",
        "input_ancestor",
        "input_focus_set"
      ]
    },
    {
      "name": "/@keyboard",
      "scope": "boot-input",
      "publish": true,
      "operations": [
        "read",
        "state",
        "focus_claim",
        "focus_release"
      ]
    }
  ]
}
