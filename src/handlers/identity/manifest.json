{
  "version": 1,
  "resources": [
    {
      "name": "/@memory",
      "scope": "self",
      "operations": [
        "allocate",
        "free"
      ]
    },
    {
      "name": "/@io",
      "scope": "self",
      "operations": [
        "owner_watch",
        "credentials",
        "identity_set",
        "random",
        "now_ns",
        "identity_home",
        "registry"
      ]
    },
    {
      "name": "/@filesystem",
      "operations": [
        "open",
        "stat",
        "metadata",
        "mkdir",
        "chmod",
        "chown"
      ]
    },
    {
      "name": "/@streams",
      "operations": [
        "read",
        "write"
      ]
    },
    {
      "name": "/@identity",
      "publish": true,
      "operations": [
        "info",
        "users",
        "groups",
        "begin",
        "stage",
        "commit",
        "abort",
        "credential",
        "self",
        "authenticate",
        "password",
        "home"
      ]
    }
  ]
}
