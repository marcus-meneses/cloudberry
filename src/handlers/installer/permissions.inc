/* Requested and approved policies are separate owned objects. */
struct permission_op {struct permission_op *next;const char *name;unsigned enabled;};
struct permission_resource {struct permission_resource *next;const char *name,*scope;int publish;struct permission_op *ops;};
struct permission_policy {char *json;struct permission_resource *resources,*current;};
static void policy_free(struct permission_policy *p){while(p->resources){struct permission_resource *r=p->resources;p->resources=r->next;while(r->ops){struct permission_op *o=r->ops;r->ops=o->next;release(o);}release(r);}release(p->json);*p=(struct permission_policy){0};}
static struct permission_resource *policy_resource(struct permission_policy *p,const char *name){for(struct permission_resource *r=p->resources;r;r=r->next)if(mf_equal(r->name,name))return r;return NULL;}
static struct permission_op *policy_operation(struct permission_resource *r,const char *name){for(struct permission_op *o=r?r->ops:NULL;o;o=o->next)if(mf_equal(o->name,name))return o;return NULL;}
static int policy_add_resource(void *context,const char *name,const char *scope,int publish){struct permission_policy *p=context;if(policy_resource(p,name))return 0;struct permission_resource *r=allocate(sizeof(*r));if(!r)return 0;*r=(struct permission_resource){p->resources,name,scope,publish,NULL};p->resources=r;p->current=r;return 1;}
static int policy_add_operation(void *context,const char *name){struct permission_policy *p=context;if(policy_operation(p->current,name))return 0;struct permission_op *o=allocate(sizeof(*o));if(!o)return 0;*o=(struct permission_op){p->current->ops,name,1};p->current->ops=o;return 1;}
static cb_status_t policy_parse(struct permission_policy *p,const void *data,size_t bytes){*p=(struct permission_policy){0};if(bytes==SIZE_MAX)return CB_BAD_REQUEST;p->json=allocate(bytes+1);if(!p->json)return CB_RESOURCE_FAILURE;cb_copy(p->json,data,bytes);struct manifest_parser parser={p->json,p->json+bytes,p,policy_add_resource,policy_add_operation};if(!manifest_parse(&parser)){policy_free(p);return CB_BAD_REQUEST;}return CB_OK;}
static int policy_subset(struct permission_policy *small,struct permission_policy *ceiling){for(struct permission_resource *r=small->resources;r;r=r->next){struct permission_resource *c=policy_resource(ceiling,r->name);if(!c || r->publish!=c->publish || !mf_equal(r->scope,c->scope))return 0;for(struct permission_op *o=r->ops;o;o=o->next)if(!policy_operation(c,o->name))return 0;}return 1;}
static int policy_matches(const void *approved,size_t ab,const void *requested,size_t rb){struct permission_policy a={0},r={0};int valid=!policy_parse(&a,approved,ab) && !policy_parse(&r,requested,rb) && policy_subset(&a,&r);policy_free(&a);policy_free(&r);return valid;}
static void policy_text(unsigned char *out,size_t *at,const char *s){while(*s)out[(*at)++]=*s++;}
static void policy_quote(unsigned char *out,size_t *at,const char *s){out[(*at)++]='"';while(*s){if(*s=='"' || *s=='\\')out[(*at)++]='\\';out[(*at)++]=*s++;}out[(*at)++]='"';}
static cb_status_t policy_encode(struct permission_policy *p,struct blob *out){size_t bytes=64;for(struct permission_resource *r=p->resources;r;r=r->next){size_t n=cb_length(r->name)+cb_length(r->scope);if(bytes>SIZE_MAX-128 || n>(SIZE_MAX-bytes-128)/2)return CB_RESOURCE_FAILURE;bytes+=128+n*2;for(struct permission_op *o=r->ops;o;o=o->next){n=cb_length(o->name);if(bytes>SIZE_MAX-8 || n>(SIZE_MAX-bytes-8)/2)return CB_RESOURCE_FAILURE;bytes+=8+n*2;}}
    out->data=allocate(bytes);if(!out->data)return CB_RESOURCE_FAILURE;size_t at=0;unsigned resources=0;policy_text(out->data,&at,"{\"version\":1,\"resources\":[");for(struct permission_resource *r=p->resources;r;r=r->next){unsigned operations=0;for(struct permission_op *o=r->ops;o;o=o->next)operations+=o->enabled;if(!operations)continue;if(resources++)out->data[at++]=',';policy_text(out->data,&at,"{\"name\":");policy_quote(out->data,&at,r->name);policy_text(out->data,&at,",\"scope\":");policy_quote(out->data,&at,r->scope);policy_text(out->data,&at,r->publish?",\"publish\":true,\"operations\":[":",\"publish\":false,\"operations\":[");unsigned count=0;for(struct permission_op *o=r->ops;o;o=o->next)if(o->enabled){if(count++)out->data[at++]=',';policy_quote(out->data,&at,o->name);}policy_text(out->data,&at,"]}");}policy_text(out->data,&at,"]}");out->bytes=at;return CB_OK;
}
static cb_status_t policy_select(const struct bundle *b,const void *prior,size_t prior_bytes,const struct blob *explicit,struct blob *out){struct permission_policy requested={0},selected={0};cb_status_t s=policy_parse(&requested,b->data+b->header+b->name,b->manifest);if(s)return s;
    if(explicit && explicit->data){s=policy_parse(&selected,explicit->data,explicit->bytes);if(!s && !policy_subset(&selected,&requested))s=CB_DENIED;}
    else {s=policy_parse(&selected,b->data+b->header+b->name,b->manifest);if(!s && prior){struct permission_policy old={0};s=policy_parse(&old,prior,prior_bytes);if(!s)for(struct permission_resource *r=selected.resources;r;r=r->next){struct permission_resource *p=policy_resource(&old,r->name);int compatible=p && p->publish==r->publish && mf_equal(p->scope,r->scope);for(struct permission_op *o=r->ops;o;o=o->next)o->enabled=compatible && policy_operation(p,o->name);}policy_free(&old);}}
    if(!s)s=policy_encode(&selected,out);
    policy_free(&requested);policy_free(&selected);return s;
}
