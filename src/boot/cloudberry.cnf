# Cloudberry boot configuration, format version 1. Keys are case-sensitive.
version=1
# Development QEMU uses UTC RTC. Omit/disable for firmware with unknown timezone.
clock.rtc_utc=true
boot.show_inventory=true
drivers.directory=/system/kmodules/drivers
storage.timeout_ms=1000
# GPT identity shared by the image builder and the boot configuration.
drivers.partition_guid=9beaeafd-7835-446a-8258-00331878d4f3
# Driver selection remains caller-owned; storage timeout bounds USB BOT commands.

# Disk-loaded module basenames, in dependency order; empty loads none.
# virtio-gpu discovery is read-only; GPU reset/scanout takeover remains explicit.
drivers.modules=gpu-virtio

# Provider basenames in startup order; empty starts none.
# display/graphics are logical roles: select a qualified OpenGL pair or VGA fallback.
boot.providers=keyboard,display,graphics,mouse,text,filesystem,identity,sessions,installer,applications

# Writable only on a writable medium; QEMU can provide a disposable snapshot.
filesystem.writable=true
